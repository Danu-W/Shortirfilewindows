{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortir-file",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "www.shortirefile.my.id",
      "custom_domain": true
    }
  ]
}
